  "description": "A safe environment variable manager that prevents secret leaks by storing environment variables outside your repository",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.js",
    "dev": "bun src/index.js",
    "prepublishOnly": "bun run build"
  },
