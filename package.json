    "envx": "dist/index.js"
  },
  "keywords": [
    "environment",
    "variables",
    "env",
    "secrets",
    "security",
    "git-safe",
    "cli",
    "dotenv",
    "config"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/galanteria01/envx.git"
  },
  "bugs": {
    "url": "https://github.com/galanteria01/envx/issues"
  },
  "homepage": "https://github.com/galanteria01/envx#readme",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.2"
  }
